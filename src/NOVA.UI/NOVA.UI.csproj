<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWPF>true</UseWPF>
    <AssemblyName>NOVADVBStudio</AssemblyName>
    <RootNamespace>NOVA.UI</RootNamespace>
    <ApplicationIcon>Assets\nova.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <ProjectReference Include="..\NOVA.Core\NOVA.Core.csproj" />
    <ProjectReference Include="..\NOVA.Logging\NOVA.Logging.csproj" />
    <ProjectReference Include="..\NOVA.Database\NOVA.Database.csproj" />
    <ProjectReference Include="..\NOVA.Media\NOVA.Media.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="wwwroot\**\*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\nova.ico" />
  </ItemGroup>
</Project>
